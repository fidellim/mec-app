APP_NAME="MEC Group Portal"
APP_ENV=e2e
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dubai
APP_URL=http://127.0.0.1:8765
E2E_APP_ENV=e2e
E2E_BASE_URL=http://127.0.0.1:8765
E2E_SLOW_MO=0
E2E_WORKERS=1
E2E_DISABLE_LOGIN_THROTTLE=true
E2E_DISABLE_EXPORT_THROTTLE=true
PHP_BINARY=php

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=timesheet_program_e2e
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="timesheets@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MISSING_TIMESHEET_REMINDER_COOLDOWN_HOURS=24
