{
  "name": "mec-group-portal",
  "displayName": "MEC Group Portal",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e:prepare": "node tests/E2E/prepare-e2e-db.cjs",
    "test:e2e:fresh": "npm run test:e2e:prepare && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:edge": "playwright test --config=playwright.edge.config.js",
    "test:e2e:edge:fresh": "npm run test:e2e:prepare && npm run test:e2e:edge",
    "test:e2e:edge:headed": "playwright test --config=playwright.edge.config.js --headed",
    "test:e2e:webkit": "playwright test --config=playwright.webkit.config.js",
    "test:e2e:webkit:fresh": "npm run test:e2e:prepare && npm run test:e2e:webkit",
    "test:e2e:webkit:headed": "playwright test --config=playwright.webkit.config.js --headed",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:headed:slow": "node tests/E2E/run-headed-slow.cjs",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0"
  },
  "allowScripts": {
    "fsevents@2.3.2": true
  }
}
